{
  "name": "@garage49/adoc-plugin-kit",
  "version": "0.1.3",
  "license": "0BSD",
  "type": "module",
  "description": "Everything an adoc plugin imports: definePlugin, html, markdown and markup helpers.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garage49/adoc.git",
    "directory": "packages/plugin-kit"
  },
  "files": [
    "dist",
    "skill",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./skill/SKILL.md": "./skill/SKILL.md",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "15.0.2",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b && tsc -p test",
    "test": "vitest run --testTimeout 20000",
    "prepack": "node ../../tooling/package-files.mjs"
  }
}
