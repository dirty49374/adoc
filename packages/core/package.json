{
  "name": "@agent-workshop/adoc-core",
  "version": "0.1.2",
  "license": "0BSD",
  "type": "module",
  "description": "adoc workspace, plugins, documents, messages, transports and server.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dirty49374/adoc.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "skill",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@agent-workshop/adoc-plugin-kanban": "workspace:*",
    "@agent-workshop/adoc-plugin-kit": "workspace:*",
    "@agent-workshop/adoc-plugin-note": "workspace:*",
    "@agent-workshop/adoc-plugin-sketch": "workspace:*",
    "@agent-workshop/adoc-plugin-task": "workspace:*",
    "@agent-workshop/adoc-plugin-todo": "workspace:*",
    "@agent-workshop/adoc-webapp": "workspace:*",
    "semver": "7.8.5",
    "ws": "8.21.3",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b && tsc -p test",
    "test": "vitest run --testTimeout 20000",
    "prepack": "node ../../tooling/package-files.mjs"
  },
  "devDependencies": {
    "@agent-workshop/adoc-testing": "workspace:*",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.1"
  }
}
