{
  "name": "@garage49/adoc",
  "version": "0.2.1",
  "license": "0BSD",
  "type": "module",
  "description": "adoc: the command line and MCP tool for a user and an agent working on plugin-defined documents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/garage49/adoc.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "bin": {
    "adoc": "./dist/entry.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@garage49/adoc-core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.1",
    "commander": "15.0.0",
    "shell-quote": "1.10.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "scripts": {
    "build": "tsc -b && node build.mjs",
    "check": "tsc -b && tsc -p test",
    "test": "vitest run --testTimeout 20000",
    "prepack": "node ../../tooling/package-files.mjs --readme"
  },
  "devDependencies": {
    "@types/shell-quote": "1.7.5",
    "@garage49/adoc-testing": "workspace:*"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ]
}
